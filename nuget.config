<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Fallback source. Prerelease builds of DurableFunctionsMonitor.DotNetIsolated[.MsSql|.Netherite]
      are pushed here by .github/workflows/main-build.yml, so a custom backend can consume one before
      a version is cut to nuget.org.

      There is deliberately no <packageSourceMapping> in this file. Package source mapping turns a
      source that cannot be reached into a hard restore failure (NU1301), which would mean nobody
      could restore this repo without first configuring a GitHub PAT. Without it, an unauthenticated
      GitHub Packages source is only a warning and nuget.org still supplies the package - which is
      what makes this an actual fallback. The trade-off is that DurableFunctionsMonitor.* package ids
      are no longer pinned to a specific source; reinstate the mapping if that matters more than
      restore working out of the box.
    -->
    <add key="github" value="https://nuget.pkg.github.com/ViswanathBalusu/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    GitHub Packages requires authentication even for public repos. NuGet expands %VARIABLE% here, so
    the same config authenticates in both places:

      CI     - .github/workflows/*.yml export GITHUB_USER and GITHUB_TOKEN from the token the
               workflow already has.
      Local  - export the same two variables from your shell profile, using a classic PAT with the
               'read:packages' scope:

                 GITHUB_USER=<your-github-username>
                 GITHUB_TOKEN=<PAT with read:packages>

    Leaving them unset is fine until you actually need a prerelease: restore logs a GitHub
    authentication warning and carries on against nuget.org.
  -->
  <packageSourceCredentials>
    <github>
      <add key="Username" value="%GITHUB_USER%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </github>
  </packageSourceCredentials>

</configuration>
