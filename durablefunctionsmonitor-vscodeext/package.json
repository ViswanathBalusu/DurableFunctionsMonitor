{
    "name": "durablefunctionsmonitor-reimagined",
    "displayName": "Durable Functions Monitor Reimagined",
    "description": "Monitoring/debugging UI tool for Azure Durable Functions",
    "version": "6.15.0",
    "publisher": "DurableFunctionsMonitor",
    "license": "MIT",
    "icon": "logo.png",
    "homepage": "https://github.com/ViswanathBalusu/DurableFunctionsMonitor",
    "repository": {
        "type": "git",
        "url": "https://github.com/ViswanathBalusu/DurableFunctionsMonitor"
    },
    "bugs": {
        "url": "https://github.com/ViswanathBalusu/DurableFunctionsMonitor/issues"
    },
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Debuggers",
        "Visualization",
        "Other"
    ],
    "keywords": [
        "Azure Durable Functions",
        "Azure Durable Entities",
        "Azure Functions",
        "Serverless",
        "Azure"
    ],
    "extensionKind": [
        "workspace"
    ],
    "capabilities": {
        "virtualWorkspaces": {
            "supported": false,
            "description": "The monitor starts a local backend process, which needs a local file system."
        },
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "Connection strings are not read from host.json and local.settings.json of an untrusted workspace."
        }
    },
    "activationEvents": [
        "onDebug"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "durableFunctionsMonitor",
                    "title": "Durable Functions Monitor",
                    "icon": "resources/activitybar.svg"
                }
            ]
        },
        "views": {
            "durableFunctionsMonitor": [
                {
                    "id": "durableFunctionsMonitorTreeView",
                    "name": "Durable Functions"
                }
            ]
        },
        "commands": [
            {
                "command": "durable-functions-monitor.signInToAzure",
                "title": "Sign in to Azure..."
            },
            {
                "command": "durable-functions-monitor.durableFunctionsMonitor",
                "title": "Durable Functions Monitor"
            },
            {
                "command": "durable-functions-monitor.durableFunctionsMonitorPurgeHistory",
                "title": "Durable Functions Monitor: Purge History..."
            },
            {
                "command": "durable-functions-monitor.durableFunctionsMonitorCleanEntityStorage",
                "title": "Durable Functions Monitor: Clean Entity Storage..."
            },
            {
                "command": "durable-functions-monitor.durableFunctionsMonitorBatchOps",
                "title": "Durable Functions Monitor: Execute Batch Operations..."
            },
            {
                "command": "durable-functions-monitor.durableFunctionsMonitorGotoInstanceId",
                "title": "Durable Functions Monitor: Go to instanceId..."
            },
            {
                "command": "durable-functions-monitor.durableFunctionsMonitorVisualizeAsGraph",
                "title": "Visualize Functions as a Graph..."
            },
            {
                "command": "durable-functions-monitor.installCoreTools",
                "title": "Durable Functions Monitor: Download Azure Functions Core Tools",
                "shortTitle": "Download Azure Functions Core Tools",
                "icon": "$(cloud-download)"
            },
            {
                "command": "durable-functions-monitor.showLog",
                "title": "Durable Functions Monitor: Show Log",
                "shortTitle": "Show Log",
                "icon": "$(output)"
            },
            {
                "command": "durable-functions-monitor.openSettings",
                "title": "Durable Functions Monitor: Open Settings",
                "shortTitle": "Settings",
                "icon": "$(gear)"
            },
            {
                "command": "durable-functions-monitor.configureStorageEmulator",
                "title": "Durable Functions Monitor: Configure Storage Emulator...",
                "shortTitle": "Configure Storage Emulator...",
                "icon": "$(database)"
            },
            {
                "command": "durable-functions-monitor.openDotnetDownload",
                "title": "Durable Functions Monitor: Open the .NET Download Page"
            },
            {
                "command": "durableFunctionsMonitorTreeView.attachToTaskHub",
                "title": "Attach"
            },
            {
                "command": "durableFunctionsMonitorTreeView.detachFromTaskHub",
                "title": "Detach"
            },
            {
                "command": "durableFunctionsMonitorTreeView.openInstancesInStorageExplorer",
                "title": "Open *Instances table in Storage Explorer"
            },
            {
                "command": "durableFunctionsMonitorTreeView.openHistoryInStorageExplorer",
                "title": "Open *History table in Storage Explorer"
            },
            {
                "command": "durableFunctionsMonitorTreeView.deleteTaskHub",
                "title": "Delete Task Hub..."
            },
            {
                "command": "durableFunctionsMonitorTreeView.refresh",
                "title": "Refresh",
                "category": "Durable Functions Monitor",
                "icon": "$(refresh)"
            },
            {
                "command": "durableFunctionsMonitorTreeView.attachToAnotherTaskHub",
                "title": "Attach to Task Hub...",
                "category": "Durable Functions Monitor",
                "icon": "$(plug)"
            },
            {
                "command": "durableFunctionsMonitorTreeView.detachFromAllTaskHubs",
                "title": "Detach from all Task Hubs...",
                "category": "Durable Functions Monitor",
                "icon": "$(debug-disconnect)"
            },
            {
                "command": "durableFunctionsMonitorTreeView.purgeHistory",
                "title": "Purge History..."
            },
            {
                "command": "durableFunctionsMonitorTreeView.cleanEntityStorage",
                "title": "Clean Entity Storage..."
            },
            {
                "command": "durableFunctionsMonitorTreeView.batchOps",
                "title": "Execute Batch Operations..."
            },
            {
                "command": "durableFunctionsMonitorTreeView.gotoInstanceId",
                "title": "Go to instanceId..."
            },
            {
                "command": "durableFunctionsMonitorTreeView.startNewInstance",
                "title": "Start New Orchestration Instance..."
            },
            {
                "command": "durableFunctionsMonitorTreeView.forgetConnectionString",
                "title": "Forget this Connection String"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "durable-functions-monitor.durableFunctionsMonitor",
                    "when": "resourceFilename == host.json",
                    "group": "DurableFunctionMonitorGroup@1"
                },
                {
                    "command": "durable-functions-monitor.durableFunctionsMonitorPurgeHistory",
                    "when": "resourceFilename == host.json",
                    "group": "DurableFunctionMonitorGroup@2"
                },
                {
                    "command": "durable-functions-monitor.durableFunctionsMonitorCleanEntityStorage",
                    "when": "resourceFilename == host.json",
                    "group": "DurableFunctionMonitorGroup@3"
                },
                {
                    "command": "durable-functions-monitor.durableFunctionsMonitorBatchOps",
                    "when": "resourceFilename == host.json",
                    "group": "DurableFunctionMonitorGroup@4"
                },
                {
                    "command": "durable-functions-monitor.durableFunctionsMonitorGotoInstanceId",
                    "when": "resourceFilename == host.json",
                    "group": "DurableFunctionMonitorGroup@5"
                },
                {
                    "command": "durable-functions-monitor.durableFunctionsMonitorVisualizeAsGraph",
                    "when": "resourceFilename == host.json",
                    "group": "DurableFunctionMonitorGroup@6"
                }
            ],
            "view/title": [
                {
                    "command": "durableFunctionsMonitorTreeView.refresh",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "navigation@1"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.detachFromAllTaskHubs",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "navigation@2"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.attachToAnotherTaskHub",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "navigation@3"
                },
                {
                    "command": "durable-functions-monitor.openSettings",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "navigation@4"
                },
                {
                    "command": "durable-functions-monitor.configureStorageEmulator",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "1_setup@1"
                },
                {
                    "command": "durable-functions-monitor.installCoreTools",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "1_setup@2"
                },
                {
                    "command": "durable-functions-monitor.showLog",
                    "when": "view == durableFunctionsMonitorTreeView",
                    "group": "1_setup@3"
                }
            ],
            "view/item/context": [
                {
                    "command": "durableFunctionsMonitorTreeView.gotoInstanceId",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-attached",
                    "group": "2_purge_history@4"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.batchOps",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-attached",
                    "group": "2_purge_history@3"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.cleanEntityStorage",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-attached",
                    "group": "2_purge_history@2"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.purgeHistory",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-attached",
                    "group": "2_purge_history@1"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.startNewInstance",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-attached",
                    "group": "2_purge_history@0"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.deleteTaskHub",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-attached",
                    "group": "3_delete_task_hub@1"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.attachToTaskHub",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == taskHub-detached",
                    "group": "1_attach_detach@1"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.detachFromTaskHub",
                    "when": "view == durableFunctionsMonitorTreeView && (viewItem == storageAccount-attached || viewItem == storedStorageAccount-attached)"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.openInstancesInStorageExplorer",
                    "when": "view == durableFunctionsMonitorTreeView && (viewItem == taskHub-attached || viewItem == taskHub-detached)",
                    "group": "4_storage_explorer@1"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.openHistoryInStorageExplorer",
                    "when": "view == durableFunctionsMonitorTreeView && (viewItem == taskHub-attached || viewItem == taskHub-detached)",
                    "group": "4_storage_explorer@2"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.forgetConnectionString",
                    "when": "view == durableFunctionsMonitorTreeView && (viewItem == storedStorageAccount-attached || viewItem == storedStorageAccount-detached)"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.attachToAnotherTaskHub",
                    "when": "view == durableFunctionsMonitorTreeView && viewItem == connectionStrings"
                }
            ],
            "commandPalette": [
                {
                    "command": "durableFunctionsMonitorTreeView.attachToTaskHub",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.detachFromTaskHub",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.openInstancesInStorageExplorer",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.openHistoryInStorageExplorer",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.deleteTaskHub",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.purgeHistory",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.cleanEntityStorage",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.batchOps",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.gotoInstanceId",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.startNewInstance",
                    "when": "false"
                },
                {
                    "command": "durableFunctionsMonitorTreeView.forgetConnectionString",
                    "when": "false"
                },
                {
                    "command": "durable-functions-monitor.openDotnetDownload",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "Durable Functions Monitor",
            "properties": {
                "durableFunctionsMonitor.backendBaseUrl": {
                    "type": "string",
                    "scope": "machine",
                    "default": "http://localhost:{portNr}/durable-functions-monitor/a/p/i",
                    "markdownDescription": "URL the backend(s) to be started on. Only the scheme, the host and the port are taken from it: the path is always the one the backend serves. You might want e.g. to change `localhost` to `127.0.0.1`, if you are observing firewall issues. You can also specify a custom port range here, like this: `http://localhost:[8080-9080]` (default port range is 37072-38000)."
                },
                "durableFunctionsMonitor.customPathToBackendBinaries": {
                    "type": "string",
                    "scope": "machine",
                    "markdownDescription": "Local path to a custom backend implementation to use. Overrides the bundled backends when set."
                },
                "durableFunctionsMonitor.customPathToAzureFunctionsHost": {
                    "type": "string",
                    "scope": "machine",
                    "markdownDescription": "Full path to the Azure Functions Core Tools executable (`func` or `func.exe`) to use. By default an installed Azure Functions Core Tools is used, and if there is none, the extension downloads one. This setting overrides both."
                },
                "durableFunctionsMonitor.coreTools.download": {
                    "type": "string",
                    "scope": "machine",
                    "enum": [
                        "always",
                        "prompt",
                        "never"
                    ],
                    "enumDescriptions": [
                        "Download Azure Functions Core Tools automatically, when none is installed.",
                        "Ask before downloading Azure Functions Core Tools.",
                        "Never download anything. The monitor then needs Azure Functions Core Tools to be installed, or `customPathToAzureFunctionsHost` to be set."
                    ],
                    "default": "always",
                    "markdownDescription": "What to do when the monitor needs Azure Functions Core Tools, but none is installed. The download is the official release from [Azure/azure-functions-core-tools](https://github.com/Azure/azure-functions-core-tools/releases), verified against a checksum pinned in this extension, and is kept in the global storage of this extension."
                },
                "durableFunctionsMonitor.backendTimeoutInSeconds": {
                    "type": "number",
                    "default": 60,
                    "minimum": 5,
                    "markdownDescription": "Number of seconds to wait for the backend to start."
                },
                "durableFunctionsMonitor.storageEmulatorConnectionString": {
                    "type": "string",
                    "default": "AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;DefaultEndpointsProtocol=http;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;QueueEndpoint=http://127.0.0.1:10001/devstoreaccount1;TableEndpoint=http://127.0.0.1:10002/devstoreaccount1;",
                    "markdownDescription": "Connection String to talk to local Storage Emulator. The AccountKey here is a well-known AccountKey. Customize endpoint URLs when needed (e.g. when Windows reserves the default ports for itself, which makes Azurite fail with `EACCES`)."
                },
                "durableFunctionsMonitor.showTimeAs": {
                    "type": "string",
                    "default": "UTC",
                    "enum": [
                        "UTC",
                        "Local"
                    ],
                    "markdownDescription": "In which time zone time values should be displayed."
                },
                "durableFunctionsMonitor.showWhenDebugSessionStarts": {
                    "type": "boolean",
                    "default": false,
                    "markdownDescription": "Show Durable Functions Monitor when you start debugging a Durable Functions project."
                },
                "durableFunctionsMonitor.taskHubsDiscoveryMode": {
                    "type": "string",
                    "enum": [
                        "Default",
                        "Do not use Storage keys",
                        "Do not use Azure account"
                    ],
                    "default": "Default",
                    "markdownDescription": "Task Hubs discovery mode. `Default` first tries to `listKeys` on the Storage account and then falls back to User Identity. `Do not use Storage keys` always uses User Identity. `Do not use Azure account` always uses Storage keys."
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build:production",
        "typecheck": "tsc --noEmit",
        "typecheck:watch": "tsc --noEmit --watch --preserveWatchOutput",
        "lint": "eslint .",
        "build": "node esbuild.mjs",
        "build:production": "node esbuild.mjs --production",
        "watch": "node esbuild.mjs --watch",
        "compile": "npm run typecheck && npm run build",
        "test": "npm run test:unit",
        "test:unit": "vitest run",
        "test:integration": "vscode-test",
        "package": "vsce package --no-dependencies",
        "update-core-tools": "node scripts/update-core-tools.mjs"
    },
    "dependencies": {
        "@azure/arm-resourcegraph": "5.0.0",
        "@azure/arm-storage": "21.0.0",
        "@microsoft/vscode-azext-azureauth": "5.1.1",
        "az-func-as-a-graph.core": "1.3.3",
        "yauzl": "3.4.0"
    },
    "devDependencies": {
        "@eslint/js": "10.0.1",
        "@types/mocha": "10.0.10",
        "@types/node": "22.20.5",
        "@types/vscode": "1.100.0",
        "@types/yauzl": "3.4.0",
        "@vscode/test-cli": "0.0.15",
        "@vscode/test-electron": "3.1.0",
        "@vscode/vsce": "4.0.0",
        "esbuild": "0.28.2",
        "eslint": "10.13.0",
        "globals": "17.13.0",
        "mocha": "12.0.3",
        "typescript": "5.9.3",
        "typescript-eslint": "8.72.1",
        "vitest": "5.0.5"
    },
    "overrides": {
        "@azure/msal-node": "7.1.1",
        "@vscode/test-cli": {
            "diff": "8.0.4",
            "serialize-javascript": "7.1.4",
            "mocha": "$mocha"
        }
    }
}
