<Project Sdk="Microsoft.VisualStudio.JavaScript.SDK/1.0.6578810">

  <!--
    Wraps the VsCode extension as an MSBuild project so it can live in DurableFunctionsMonitor.slnx.
    Building it runs "npm run compile": the type check, then esbuild, which bundles the extension into dist/.
    Packaging the VSIX still goes through "npm run package",
    which needs the published backends copied in first - see .github/workflows/build.yml.
  -->

  <PropertyGroup>
    <BuildCommand>npm run compile</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>

    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
  </PropertyGroup>

</Project>
