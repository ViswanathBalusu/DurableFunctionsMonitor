// Starts the extension in an Extension Development Host. "npm: watch" rebuilds dist/ on every change.
// The integration tests are run by "npm run test:integration" (or the Extension Test Runner extension).
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ],
            "outFiles": [
                "${workspaceFolder}/dist/**/*.js"
            ],
            "preLaunchTask": "${defaultBuildTask}"
        }
    ]
}
