{
    "compilerOptions": {
        // esbuild bundles and transpiles; tsc is only the type checker (see "typecheck" in package.json)
        "noEmit": true,
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "target": "ES2022",
        // No "dom": this runs in the extension host (Node), where fetch and AbortSignal come from @types/node
        "lib": ["ES2022"],
        "types": ["node", "mocha"],
        "strict": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "isolatedModules": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true
    },
    "include": ["src", "test", "scripts"],
    "exclude": ["node_modules", "dist", "out", "backend", "custom-backends", ".vscode-test"]
}
