<Project>

  <!--
    Single source of truth for the version of every .NET project in this repo.

    To cut a release:
      1. Bump VersionPrefix below
      2. Commit
      3. Tag the commit "v<VersionPrefix>" and push the tag.
         .github/workflows/publish-nuget.yml verifies the tag matches this value,
         then packs and pushes to nuget.org.

    The same workflow also publishes prereleases of the version below, as
    "v<VersionPrefix>-rc.<n>" or "v<VersionPrefix>-develop.<n>". Only the release part
    of the tag is checked against this value, so a prerelease needs no bump here -
    which is what keeps AssemblyVersion (VersionPrefix + ".0") numeric. nuget.org
    keeps them off "latest stable", and SemVer orders develop.N < rc.N < the release.

    CI builds off main publish <VersionPrefix>-preview.<run number> to GitHub Packages.
    That suffix is deliberately not one publish-nuget.yml accepts: previews live there.
  -->
  <PropertyGroup>
    <VersionPrefix>6.12.0</VersionPrefix>
  </PropertyGroup>

  <!--
    Single source of truth for the target framework of every C# project in this repo.
    Scoped to .csproj so it never leaks into the .esproj (JavaScript SDK) projects,
    which pin their own TargetFramework internally.
  -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>DurableFunctionsMonitor</Authors>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/ViswanathBalusu/DurableFunctionsMonitor</RepositoryUrl>
  </PropertyGroup>

</Project>
