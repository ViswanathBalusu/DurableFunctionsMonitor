save-exact=true

; engine-strict is off on purpose. The plan pins jsdom 30.0.1 (README "Package versions"), whose
; `engines` field demands Node ^22.22.2 || ^24.15.0 || >=26, while the reference toolchain is Node
; 22.18. With engine-strict=true `npm ci` refuses to install the pinned tree. jsdom 30 runs fine on
; 22.18; the pins win. Set this back to true once the toolchain moves to Node >= 22.22.2.
engine-strict=false
