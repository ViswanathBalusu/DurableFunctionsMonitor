{
  "name": "durablefunctionsmonitor.svelte",
  "private": true,
  "version": "6.12.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-and-copy": "npm run build && node copy-build-artifacts.js",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "seed": "node tests/e2e/seed/seed-hub.mjs",
    "host": "node ../scripts/harness/start-host.mjs",
    "test:e2e:local": "npm run seed && playwright test",
    "verify": "node ../scripts/harness/verify-build-contract.mjs build",
    "preview:styles": "node ../scripts/harness/style-preview.mjs --shoot"
  },
  "dependencies": {
    "@azure/msal-browser": "5.26.0",
    "@dagrejs/dagre": "3.1.3",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@internationalized/date": "3.12.4",
    "@lucide/svelte": "1.61.0",
    "@tanstack/svelte-virtual": "3.13.48",
    "@tanstack/table-core": "9.3.1",
    "@xyflow/svelte": "1.7.0",
    "bits-ui": "2.19.5",
    "clsx": "2.1.1",
    "d3": "7.9.0",
    "mode-watcher": "1.1.0",
    "svelte": "5.57.2",
    "svelte-jsoneditor": "3.13.0",
    "svelte-sonner": "1.2.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@azure/data-tables": "13.3.2",
    "@azure/storage-blob": "12.34.0",
    "@azure/storage-queue": "12.32.0",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "@types/d3": "7.4.3",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-svelte": "3.23.1",
    "jsdom": "30.1.3",
    "ncp": "2.0.0",
    "prettier": "3.9.10",
    "prettier-plugin-svelte": "4.1.1",
    "rimraf": "6.1.3",
    "shadcn-svelte": "1.7.1",
    "svelte-check": "4.7.7",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
