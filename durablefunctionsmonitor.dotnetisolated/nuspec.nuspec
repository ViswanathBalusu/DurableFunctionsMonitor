<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata minClientVersion="2.5">
        <id>$id$</id>
        <version>$version$</version>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>DurableFunctionsMonitor.DotNetIsolated</description>
        <readme>README.md</readme>
        <authors>DurableFunctionsMonitor</authors>
        <repository type="git" url="https://github.com/ViswanathBalusu/DurableFunctionsMonitor" />
        <license type="file">LICENSE.txt</license>

        <!--
            nuget pack infers nothing from a hand-written .nuspec: this list is the ONLY thing that
            puts an assembly next to lib/net10.0/durablefunctionsmonitor.dotnetisolated.core.dll in a
            consumer's Function App. Anything core.dll compiled against and that is missing here is a
            FileNotFoundException the first time the consumer hits the code path that needs it.

            So it has to cover every <PackageReference> of every .csproj whose assembly is packed into
            lib/ below, at a version no lower than the one that project builds against.
            scripts/harness/verify-nuspec-dependencies.mjs enforces exactly that, in CI before packing.
            Entries beyond that are what the consumer's own Function App needs.

            The Azure Functions SDK is not one of them: it is an MSBuild SDK, which a project file chooses
            (<Project Sdk="Azure.Functions.Sdk/...">), and a package cannot depend on.
        -->
        <dependencies>
            <dependency id="Microsoft.Azure.Functions.Worker" version="2.52.0" />
            <dependency id="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" version="1.20.1" />
            <dependency id="Microsoft.Azure.Functions.Worker.Extensions.Http" version="3.3.0" />
            <dependency id="Azure.Data.Tables" version="12.13.0" />
            <dependency id="Azure.Storage.Blobs" version="12.30.1" />
            <dependency id="Azure.Storage.Queues" version="12.28.1" />
            <dependency id="Azure.Identity" version="1.21.0" />
            <dependency id="Microsoft.IdentityModel.Protocols.OpenIdConnect" version="8.23.0" />
            <dependency id="Fluid.Core" version="2.40.0" />
            <dependency id="Newtonsoft.Json" version="13.0.4" />
        </dependencies>

    </metadata>

    <files>
        <file src="..\output\durablefunctionsmonitor.dotnetisolated.core.dll" target="lib/net10.0" />
        <file src="..\output\durablefunctionsmonitor.dotnetisolated.core.xml" target="lib/net10.0" />
        <file src="..\output\durablefunctionsmonitor.dotnetisolated.targets" target="build/$id$.targets" />
        <file src="..\output\*" target="/" />
        <file src="..\output\.azurefunctions\**" target="/.azurefunctions" />
        <file src="..\output\DfmStatics\**" target="/DfmStatics" />
    </files>
</package>
