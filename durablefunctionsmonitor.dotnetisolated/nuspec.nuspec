<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2010/07/nuspec.xsd">
    <metadata minClientVersion="2.5">
        <id>$id$</id>
        <version>$version$</version>
        <requireLicenseAcceptance>false</requireLicenseAcceptance>
        <description>DurableFunctionsMonitor.DotNetIsolated</description>
        <authors>DurableFunctionsMonitor</authors>
        <repository type="git" url="https://github.com/ViswanathBalusu/DurableFunctionsMonitor" />
        <license type="file">LICENSE.txt</license>

        <dependencies>
            <dependency id="Microsoft.Azure.Functions.Worker" version="2.52.0" />
            <dependency id="Microsoft.Azure.Functions.Worker.Sdk" version="2.1.0" />
            <dependency id="Microsoft.Azure.Functions.Worker.Extensions.DurableTask" version="1.19.0" />
            <dependency id="Microsoft.Azure.Functions.Worker.Extensions.Http" version="3.3.0" />
            <dependency id="Azure.Data.Tables" version="12.12.0" />
            <dependency id="Azure.Storage.Blobs" version="12.29.2" />
            <dependency id="Azure.Identity" version="1.21.0" />
            <dependency id="Microsoft.IdentityModel.Protocols.OpenIdConnect" version="8.22.0" />
            <dependency id="Fluid.Core" version="2.40.0" />
        </dependencies>

    </metadata>

    <files>
        <file src="..\output\durablefunctionsmonitor.dotnetisolated.core.dll" target="lib/net10.0" />
        <file src="..\output\durablefunctionsmonitor.dotnetisolated.core.xml" target="lib/net10.0" />
        <file src="..\output\durablefunctionsmonitor.dotnetisolated.targets" target="build/$id$.targets" />
        <file src="..\output\*" target="/" />
        <file src="..\output\.azurefunctions\**" target="/.azurefunctions" />
        <file src="..\output\DfmStatics\**" target="/DfmStatics" />
    </files>
</package>