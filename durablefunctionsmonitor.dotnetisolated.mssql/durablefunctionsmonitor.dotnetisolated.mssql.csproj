<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <!--
      SqlClient brings System.Security.Cryptography.Pkcs in, at a 9.0.x version that has two known denial-of-service
      advisories (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). 10.0.13 is the release of the version this runs on that has the fix.
      Remove this when SqlClient asks for a fixed version itself. custom-backends/dotnetIsolated-mssql/nuspec.nuspec has it too.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\durablefunctionsmonitor.dotnetisolated.core\durablefunctionsmonitor.dotnetisolated.core.csproj" />
  </ItemGroup>
</Project>
