<Project Sdk="Microsoft.VisualStudio.JavaScript.SDK/1.0.6578810">

  <!--
    Wraps the React front-end as an MSBuild project so it can live in DurableFunctionsMonitor.slnx
    alongside the C# projects. All it does is shell out to the npm scripts in package.json - npm
    remains the source of truth for how this app is built.
  -->

  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>

    <!-- "npm run build" = disable-webpack-chunking.js + react-scripts build, emitting into build/ -->
    <BuildCommand>npm run build</BuildCommand>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\build</BuildOutputFolder>

    <JavaScriptTestRoot>tests\</JavaScriptTestRoot>
    <JavaScriptTestFramework>Playwright</JavaScriptTestFramework>

    <!--
      npm audit reports transitive advisories in the react-scripts dependency tree that cannot be
      fixed without migrating off Create React App. Keep it out of the build signal.
    -->
    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
  </PropertyGroup>

</Project>
